+	// package syscall imports ie_execve from libiosexec, because a rootless
+	// jailbreak has no /bin/sh and the kernel will not resolve a shebang that
+	// names an interpreter in the sealed rootfs. ios always links externally,
+	// and some of those links run with cgo disabled (go_bootstrap is one), so
+	// the library cannot be attached through the cgo directives of
+	// runtime/cgo. The jailbreak prefix is not on dyld's default search path,
+	// hence the rpath.
+	if buildcfg.GOOS == "ios" {
+		argv = append(argv, "-liosexec", "-Wl,-rpath,/var/jb/usr/lib")
+	}
+
