#!/var/jb/bin/sh
# Write pcsc-lite reader.conf for the Q3U4 internal reader.
# pcscd (launchd) と px4d は同じユーザーで動かす（access=user、ソケット 0600）。
set -e
if [ "$#" -ne 2 ]; then
  echo "usage: px4-pcsc-register BASE_SERIAL RUNTIME_DIR" >&2
  exit 2
fi
base=$1
rt=$2
tmpl=/var/jb/usr/share/px4-userland/px4-userland.conf.in
ifd=/var/jb/usr/lib/px4-userland/libpx4-userland-ifd.dylib
conf=/var/jb/etc/reader.conf.d/px4-userland.conf
if [ ! -f "$tmpl" ] || [ ! -f "$ifd" ]; then
  echo "px4-pcsc-register: missing template or IFD dylib" >&2
  exit 1
fi
mkdir -p /var/jb/etc/reader.conf.d
sed -e "s|@PX4_RUNTIME_DIR@|${rt}|g" \
    -e "s|@PX4_BASE_SERIAL@|${base}|g" \
    -e "s|@PX4_ACCESS@|user|g" \
    -e "s|@PX4_IFD_LIBRARY@|${ifd}|g" \
    "$tmpl" > "$conf"
echo "wrote $conf"
if launchctl kickstart -k user/foreground/fr.apdu.pcscd >/dev/null 2>&1; then
  :
elif launchctl kickstart -k system/fr.apdu.pcscd >/dev/null 2>&1; then
  :
else
  killall -HUP pcscd >/dev/null 2>&1 || true
fi
