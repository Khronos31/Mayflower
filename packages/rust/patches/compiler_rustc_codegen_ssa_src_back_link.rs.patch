+
+/// Sign a Mach-O image with `ldid` so that it can run on a jailbroken iOS device.
+///
+/// The entitlements come from `RUST_LDID_ENTITLEMENTS` when set, and otherwise
+/// from the toolchain itself, mirroring how the rest of the toolchain finds its
+/// own files. Signing without entitlements still produces a runnable binary, so
+/// a missing file is not an error.
+fn sign_with_ldid(sess: &Session, out_filename: &Path, crate_type: CrateType) {
+    // Only images that dyld loads need a signature. `rlib` and `staticlib` are
+    // archives that are read by the linker, never mapped, so leave them alone.
+    // Dylibs and proc-macros do need one: rustc `dlopen`s proc-macros, and an
+    // unsigned dylib is rejected just like an unsigned executable.
+    if matches!(crate_type, CrateType::Rlib | CrateType::StaticLib) {
+        return;
+    }
+
+    let entitlements = match env::var_os("RUST_LDID_ENTITLEMENTS") {
+        Some(path) => PathBuf::from(path),
+        None => sess.opts.sysroot.path().join("lib").join("rustlib").join("entitlements.plist"),
+    };
+
+    let mut cmd = Command::new("ldid");
+    if entitlements.is_file() {
+        cmd.arg(format!("-S{}", entitlements.display()));
+    } else {
+        cmd.arg("-S");
+    }
+    cmd.arg(out_filename);
+
+    match cmd.output() {
+        Ok(prog) if prog.status.success() => {}
+        Ok(prog) => {
+            let mut output = prog.stderr.clone();
+            output.extend_from_slice(&prog.stdout);
+            sess.dcx().fatal(format!(
+                "`ldid` failed to sign `{}` with {}: {}",
+                out_filename.display(),
+                prog.status,
+                escape_string(&output)
+            ));
+        }
+        Err(error) => {
+            sess.dcx().fatal(format!("unable to run `ldid`: {error}"));
+        }
     }
 }
 
