#!/var/jb/bin/bash
#
# Mayflower | bin/cc
#
# clang を呼び、実行ファイルが出来ていれば ldid で署名する。
# 脱獄 iOS では entitlements 無しの Mach-O は起動時に SIGKILL されるため、
# ビルド中に生成される configure のテストバイナリ等もここで署名する必要がある。

output="a.out"
next=false
for arg in "$@"; do
  if [ "${next}" = "true" ]; then
    output="${arg}"
    next="false"
  elif [ "${arg::2}" = "-o" ]; then
    if [ "${arg}" = "-o" ]; then
      next="true"
    else
      output="${arg:2}"
    fi
  elif [ "${arg::8}" = "--output" ]; then
    if [ "${arg}" = "--output" ]; then
      next="true"
    else
      output="${arg:9}"
    fi
  fi
done

clang "$@" || exit

if [ -x "${output}" ]; then
  ldid -S"${ENTFILE:?ENTFILE が未設定}" "${output}"
fi
