+                    nargv[j + 1] = argv[j];
+                }
+                if (envp) {
+                    execve("/var/jb/bin/sh", nargv, envp);
+                } else {
+                    execv("/var/jb/bin/sh", nargv);
+                }
+            }
+        }
         if (errno != ENOENT && errno != ENOTDIR && saved_errno == 0) {
