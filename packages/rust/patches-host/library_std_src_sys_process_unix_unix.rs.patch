+/// Rootless jailbreak: shebang spawn is EPERM (Dopamine) or ENOENT (no /bin/sh).
+#[cfg(target_os = "ios")]
+unsafe fn jailbreak_sh_argv(
+    program: *const libc::c_char,
+    argv: *const *const libc::c_char,
+) -> (*const libc::c_char, [*const libc::c_char; 64]) {
+    const SH: &[u8] = b"/var/jb/bin/sh\0"; // rust byte string with NUL
+    let sh = SH.as_ptr().cast::<libc::c_char>();
+    let mut nargv = [core::ptr::null(); 64];
+    nargv[0] = sh;
+    nargv[1] = program;
+    let mut i = 2;
+    if !argv.is_null() {
+        let mut j = 1;
+        loop {
+            let p = *argv.add(j);
+            if p.is_null() || i >= 63 {
+                break;
+            }
+            nargv[i] = p;
+            i += 1;
+            j += 1;
+        }
+    }
+    nargv[i] = core::ptr::null();
+    (sh, nargv)
+}
+
+#[cfg(target_os = "ios")]
+fn jailbreak_should_retry(err: i32) -> bool {
+    err == libc::EPERM || err == libc::ENOEXEC || err == libc::ENOENT
+}
