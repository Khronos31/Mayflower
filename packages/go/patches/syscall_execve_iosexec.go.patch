+//go:build ios && arm64
+
+package syscall
+
+import (
+	"internal/abi"
+	"unsafe"
+)
+
+// jailbreakSh is /var/jb/bin/sh with a trailing NUL. Kept in BSS so the
+// retry path can run after fork without allocating.
+var jailbreakSh = [15]byte{'/', 'v', 'a', 'r', '/', 'j', 'b', '/', 'b', 'i', 'n', '/', 's', 'h', 0}
+
+func execve(path *byte, argv **byte, envp **byte) (err error) {
+	_, _, e1 := rawSyscall(abi.FuncPCABI0(libc_execve_trampoline), uintptr(unsafe.Pointer(path)), uintptr(unsafe.Pointer(argv)), uintptr(unsafe.Pointer(envp)))
+	if e1 == 0 {
+		return nil
+	}
+	// Dopamine returns EPERM for shebang scripts; ENOEXEC is the POSIX
+	// fallback. Retry as: /var/jb/bin/sh <path> <argv[1:]...>
+	if e1 == EPERM || e1 == ENOEXEC {
+		var nargv [64]*byte
+		nargv[0] = &jailbreakSh[0]
+		nargv[1] = path
+		i := 2
+		if argv != nil {
+			p := argv
+			if *p != nil {
+				p = (**byte)(unsafe.Pointer(uintptr(unsafe.Pointer(p)) + unsafe.Sizeof(p)))
+			}
+			for *p != nil && i < len(nargv)-1 {
+				nargv[i] = *p
+				i++
+				p = (**byte)(unsafe.Pointer(uintptr(unsafe.Pointer(p)) + unsafe.Sizeof(p)))
+			}
+		}
+		nargv[i] = nil
+		_, _, e2 := rawSyscall(abi.FuncPCABI0(libc_execve_trampoline), uintptr(unsafe.Pointer(&jailbreakSh[0])), uintptr(unsafe.Pointer(&nargv[0])), uintptr(unsafe.Pointer(envp)))
+		if e2 == 0 {
+			return nil
+		}
+		e1 = e2
+	}
+	return errnoErr(e1)
+}
+
+func libc_execve_trampoline()
+
+//go:cgo_import_dynamic libc_execve execve "/usr/lib/libSystem.B.dylib"
