#!/var/jb/bin/sh
# Mayflower | mayflower-swift-dsymutil
# dsymutil can rewrite the image; re-sign the input binary afterward.
set -e
INPUT=$1
find_real_dsymutil() {
  if [ -n "${MAYFLOWER_REAL_DSYMUTIL:-}" ] && [ -x "$MAYFLOWER_REAL_DSYMUTIL" ]; then
    printf '%s\n' "$MAYFLOWER_REAL_DSYMUTIL"
    return 0
  fi
  selfdir=$(cd "$(dirname "$0")" 2>/dev/null && pwd -P)
  for cand in /var/jb/usr/bin/dsymutil /usr/bin/dsymutil; do
    [ -x "$cand" ] || continue
    case "$cand" in
      "$selfdir"/*) continue ;;
    esac
    printf '%s\n' "$cand"
    return 0
  done
  OLDIFS=$IFS
  IFS=:
  for d in $PATH; do
    [ -x "$d/dsymutil" ] || continue
    [ "$d" = "$selfdir" ] && continue
    case "$d" in
      *mayflower-swift-tools*) continue ;;
    esac
    printf '%s\n' "$d/dsymutil"
    IFS=$OLDIFS
    return 0
  done
  IFS=$OLDIFS
  return 1
}
REAL=$(find_real_dsymutil) || {
  echo "mayflower-swift-dsymutil: dsymutil not found" >&2
  exit 127
}
"$REAL" "$@"
rc=$?
[ "$rc" -eq 0 ] || exit "$rc"
if [ -n "${SWIFT_NO_LDID:-}" ]; then
  exit 0
fi
[ -n "$INPUT" ] && [ -f "$INPUT" ] || exit 0
command -v ldid >/dev/null 2>&1 || exit 0
ENT="${SWIFT_LDID_ENTITLEMENTS:-${CLANG_LDID_ENTITLEMENTS:-}}"
if [ -z "$ENT" ]; then
  here=$(cd "$(dirname "$0")" 2>/dev/null && pwd -P)
  for cand in \
    "$here/../entitlements.plist" \
    /var/jb/usr/lib/llvm-19/entitlements.plist
  do
    [ -f "$cand" ] && ENT=$cand && break
  done
fi
if [ -n "$ENT" ]; then
  ldid -S"$ENT" "$INPUT"
else
  ldid -S "$INPUT"
fi
