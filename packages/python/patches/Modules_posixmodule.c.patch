 #ifdef HAVE_SYSTEM
+/* system(3) is marked __IOS_PROHIBITED in the iOS SDK, and the real one would
+ * exec /bin/sh, which a rootless jailbreak does not have. Mayflower links a
+ * replacement that uses the shell under the jailbreak prefix. Declared here
+ * rather than renamed with -include or -D, because pulling <stdlib.h> in early
+ * makes autoconf's old-style function checks see the real prototypes before
+ * their rename trick, and a whole set of them (the wait family, realpath,
+ * getpriority, ptsname, ...) then gets detected as missing.
+ */
+#ifdef __APPLE__
+extern int mayflower_system(const char *);
+#endif
 #ifdef MS_WINDOWS
 /*[clinic input]
 os.system -> long
@@ -6120,7 +6131,7 @@
     }
 
     Py_BEGIN_ALLOW_THREADS
-    result = system(bytes);
+    result = mayflower_system(bytes);
     Py_END_ALLOW_THREADS
     return result;
 }
