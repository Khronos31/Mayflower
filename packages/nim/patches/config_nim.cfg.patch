--- a/config/nim.cfg
+++ b/config/nim.cfg
@@ -377,3 +377,12 @@
   clang.options.linker %= "${clang.options.linker} -s"
   clang.cpp.options.linker %= "${clang.cpp.options.linker} -s"
 @end
+
+# Rootless jailbroken iOS: route exec/system through libiosexec, find
+# libraries under /var/jb, and sign executables with ldid.
+@if ios:
+  define:libiosexec
+  clang.options.linker %= "${clang.options.linker} -Wl,-rpath,/var/jb/usr/lib"
+  clang.cpp.options.linker %= "${clang.cpp.options.linker} -Wl,-rpath,/var/jb/usr/lib"
+  ldid.entitlements = "/var/jb/usr/share/nim/entitlements.plist"
+@end
