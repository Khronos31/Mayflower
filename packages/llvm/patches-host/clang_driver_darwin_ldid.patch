--- a/clang/lib/Driver/ToolChains/Darwin.cpp	2026-09-13 02:47:26
+++ b/clang/lib/Driver/ToolChains/Darwin.cpp	2026-09-13 02:47:26
@@ -22,6 +22,7 @@
 #include "llvm/Option/ArgList.h"
 #include "llvm/ProfileData/InstrProf.h"
 #include "llvm/Support/Path.h"
+#include "llvm/Support/FileSystem.h"
 #include "llvm/Support/ScopedPrinter.h"
 #include "llvm/Support/Threading.h"
 #include "llvm/Support/VirtualFileSystem.h"
@@ -924,6 +925,39 @@
   }
 
   C.addCommand(std::move(Cmd));
+
+  // Mayflower / jailbroken iOS: unsigned Mach-O is SIGKILL'd on exec and
+  // rejected by dyld on dlopen. Sign the link output here (not via a PATH
+  // wrapper) so `clang hello.c && ./a.out` works.
+  //
+  // CLANG_NO_LDID: if set (any value), skip signing. Toolchains that own the
+  // final Mach-O rewrite (Go/Rust/Nim) should set this and sign themselves
+  // after dsymutil/strip/etc., so an intermediate clang link does not hide a
+  // missing final ldid.
+  // CLANG_LDID_ENTITLEMENTS: entitlements plist path for `ldid -S`. Unset ->
+  // $PREFIX/entitlements.plist beside clang, else plain `ldid -S`.
+  if (Output.isFilename() && getToolChain().getTriple().isOSDarwin() &&
+      !::getenv("CLANG_NO_LDID")) {
+    ArgStringList LdidArgs;
+    if (const char *EnvEnt = ::getenv("CLANG_LDID_ENTITLEMENTS")) {
+      LdidArgs.push_back(Args.MakeArgString(std::string("-S") + EnvEnt));
+    } else {
+      // Prefer entitlements shipped beside llvm prefix:
+      //   $PREFIX/bin/clang -> $PREFIX/entitlements.plist
+      SmallString<256> Ent;
+      Ent = getToolChain().getDriver().Dir;
+      llvm::sys::path::append(Ent, "..", "entitlements.plist");
+      if (llvm::sys::fs::exists(Ent))
+        LdidArgs.push_back(Args.MakeArgString(std::string("-S") + Ent.c_str()));
+      else
+        LdidArgs.push_back("-S");
+    }
+    LdidArgs.push_back(Output.getFilename());
+    const char *Ldid =
+        Args.MakeArgString(getToolChain().GetProgramPath("ldid"));
+    C.addCommand(std::make_unique<Command>(JA, *this, ResponseFileSupport::None(),
+                                           Ldid, LdidArgs, Inputs, Output));
+  }
 }
 
