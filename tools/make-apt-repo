#!/var/jb/bin/bash
#
# Mayflower | tools/make-apt-repo
#
#   make-apt-repo <出力ディレクトリ> <deb>...
#
# Sileo / Cydia / apt がそのまま読める flat なリポジトリを作る。出力は
#
#   <出力>/Release  Packages  Packages.gz  Packages.xz  debs/*.deb
#
# 購読側は `deb <URL> ./` の形になる。署名はしない（脱獄リポジトリは無署名が
# 通例で、Sileo も警告を出さない）。
#
# apt-ftparchive や dpkg-scanpackages は使わない。必要なのは dpkg-deb と
# coreutils だけ。Packages.xz の圧縮は _xz_compress() が「あるもの」で lazy に
# 済ませる（圧縮できる xz → 7zz → python3(lzma) → apt で xz-utils）。

set -eu

# 圧縮できる xz を lazy に探す。見つかればパスを出力して 0。
# busybox の xz は展開専用（-9 が unrecognized option）なので、-9c を試して判定する。
_xz_find() {
  local c
  for c in "${XZ:-}" xz /usr/bin/xz /opt/homebrew/bin/xz; do
    [ -n "$c" ] || continue
    if command -v "$c" >/dev/null 2>&1 && printf '' | "$c" -9c >/dev/null 2>&1; then
      printf '%s\n' "$c"
      return 0
    fi
  done
  return 1
}

# どの binary も見つからなければ apt-get install <pkg> を lazy に試す。
#   0 = どれか使える（もとから有るか、今入れた）
#   1 = 使えない
_apt_ensure() {
  local pkg=$1 bin
  shift
  for bin in "$@"; do
    command -v "$bin" >/dev/null 2>&1 && return 0
  done
  [ -n "$(command -v apt-get)" ] || return 1
  echo "${0##*/}: ${pkg} が見つからないので apt-get install します" >&2
  apt-get install -y "$pkg" >/dev/null 2>&1 || return 1
  for bin in "$@"; do
    command -v "$bin" >/dev/null 2>&1 && return 0
  done
  return 1
}

# Packages.xz を作る。HAOS は PATH 先頭の /config/.tools/bin/xz が 7zz 委譲
# ラッパー（圧縮は busybox 落ち）のため、通常は 7zz 直呼びで成立し apt には
# 触らない。apt は「圧縮できるものが何も無いが apt だけはある」環境向けの最後の手段。
_xz_compress() {
  local f=$1 xz_bin
  if xz_bin="$(_xz_find)"; then
    "$xz_bin" -9kf "$f"
    return 0
  fi
  if command -v 7zz >/dev/null 2>&1; then
    7zz a -txz -mx=9 "$f.xz" "$f" >/dev/null
    return 0
  fi
  if command -v python3 >/dev/null 2>&1; then
    python3 - "$f" <<'PY'
import lzma
import sys
src = sys.argv[1]
open(src + '.xz', 'wb').write(lzma.compress(open(src, 'rb').read(), preset=9))
PY
    return 0
  fi
  if _apt_ensure xz-utils /usr/bin/xz; then
    if xz_bin="$(_xz_find)"; then
      "$xz_bin" -9kf "$f"
      return 0
    fi
  fi
  echo "${0##*/}: 圧縮できる xz / 7zz / python3(lzma) が見つかりません" >&2
  return 1
}

ORIGIN="${ORIGIN:-Mayflower}"
LABEL="${LABEL:-Khronos31}"
SUITE="${SUITE:-stable}"
CODENAME="${CODENAME:-stable}"
COMPONENTS="${COMPONENTS:-main}"
DESCRIPTION="${DESCRIPTION:-Packages built on-device for rootless jailbroken iOS.}"

if [ $# -lt 2 ]; then
  echo "Usage: ${0##*/} <outdir> <deb>..." >&2
  exit 1
fi

out="$1"; shift
rm -rf "$out"
mkdir -p "$out/debs"

for deb in "$@"; do
  [ -r "$deb" ] || { echo "${0##*/}: 読めない: $deb" >&2; exit 1; }
  cp "$deb" "$out/debs/${deb##*/}"
done

cd "$out"

# Packages。各 deb の control に、取得側が要る4項目を足す。
: > Packages
first=1
for deb in debs/*.deb; do
  [ "$first" = 1 ] || printf '\n' >> Packages
  first=0
  # control の末尾の空行は落とす（スタンザ区切りは自分で入れる）
  dpkg-deb -f "$deb" | sed -e '/^$/d' >> Packages
  {
    printf 'Filename: %s\n' "$deb"
    printf 'Size: %s\n' "$(stat -c %s "$deb" 2>/dev/null || stat -f %z "$deb")"
    printf 'MD5sum: %s\n' "$(md5sum "$deb" | cut -d' ' -f1)"
    printf 'SHA1: %s\n' "$(sha1sum "$deb" | cut -d' ' -f1)"
    printf 'SHA256: %s\n' "$(sha256sum "$deb" | cut -d' ' -f1)"
  } >> Packages
done
printf '\n' >> Packages

gzip -9kf Packages
_xz_compress Packages

# Release。Architectures は収録した deb から拾う（all は購読側の判定に使われない）。
archs="$(awk '/^Architecture: /{print $2}' Packages | grep -v '^all$' | sort -u | tr '\n' ' ')"
archs="${archs% }"

{
  printf 'Origin: %s\n' "$ORIGIN"
  printf 'Label: %s\n' "$LABEL"
  printf 'Suite: %s\n' "$SUITE"
  printf 'Codename: %s\n' "$CODENAME"
  printf 'Architectures: %s\n' "$archs"
  printf 'Components: %s\n' "$COMPONENTS"
  printf 'Description: %s\n' "$DESCRIPTION"
  printf 'Date: %s\n' "$(LC_ALL=C date -u '+%a, %d %b %Y %H:%M:%S UTC')"
  for algo in MD5Sum:md5sum SHA256:sha256sum; do
    printf '%s:\n' "${algo%%:*}"
    for f in Packages Packages.gz Packages.xz; do
      printf ' %s %s %s\n' \
        "$("${algo##*:}" "$f" | cut -d' ' -f1)" \
        "$(stat -c %s "$f" 2>/dev/null || stat -f %z "$f")" \
        "$f"
    done
  done
} > Release

echo "==> $out"
awk '/^Package: /{p=$2} /^Version: /{v=$2} /^Architecture: /{printf "    %-22s %-12s %s\n", p, v, $2}' Packages
printf '    合計 %s\n' "$(du -sh . | cut -f1)"
